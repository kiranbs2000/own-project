pipeline {
    tools {
        nodejs "nodejs"
    }
    agent any

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'myproject', url: 'https://github.com/kiranbs2000/own-project.git'
            }
        }

        stage('Build Node.js') {
            steps {
                sh 'npm install'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t my-app .'
            }
        }

        stage('Docker Run') {
            steps {
                sh 'docker run -d --name c1 -p 3000:3000 my-app'
            }
        }

        stage('Cleanup Docker') {
            steps {
                sh '''
                    docker stop c1 || true
                    docker rm c1 || true
                '''
            }
        }

        stage('Deploy to MicroK8s') {
            steps {
                sh '''
                    kubectl apply -f deployment.yaml
                    kubectl apply -f service.yaml
                '''
            }
        }

        stage('Deploy Monitoring Tools') {
            steps {
                sh '''
                    kubectl apply -f prometheus.yaml
                    kubectl apply -f grafana.yaml
                '''
            }
        }

    }
}
