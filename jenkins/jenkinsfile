pipeline {
    tools {
        nodejs "nodejs"
    }
    agent any

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'myproject', url: 'https://github.com/kiranbs2000/own-project.git'
            }
        }

        stage('Install Node.js Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t my-app .'
            }
        }

        stage('Docker Run') {
            steps {
                 sh '''
            # Stop and remove any container using port 3000
            CONTAINER_ID=$(docker ps -q --filter "publish=3000")
            if [ ! -z "$CONTAINER_ID" ]; then
              docker stop $CONTAINER_ID
              docker rm $CONTAINER_ID
            fi

            docker rm -f c1 || true
            docker run -d --name c1 -p 3000:3000 my-app
            sleep 10
            docker ps
        '''
            }
        }

        stage('Deploy to MicroK8s') {
            steps {
                sh '''
                    kubectl apply -f deployment.yaml
                    kubectl apply -f service.yaml
                '''
            }
        }

        stage('Deploy Monitoring Tools') {
            steps {
                script {
                    sh 'kubectl create namespace monitoring || echo "Namespace already exists"'
                    sh '''
                        kubectl apply -f prometheus.yaml -n monitoring
                        kubectl apply -f grafana.yaml -n monitoring
                    '''
                }
            }
        }
    }

    post {
        always {
            echo "Cleaning up Docker container..."
            sh '''
                docker stop c1 || true
                docker rm c1 || true
            '''
        }
    }
}
